---
import '../styles/global.css';
import { cityNavItems } from '../data/cityPages.js';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PestControl Cyprus — Pest Experts Today</title>
  <meta name="description" content="Professional pest control services across Cyprus. Ants, cockroaches, rodents, bed bugs, mosquitoes and more. Fast, eco-friendly, guaranteed." />
  <link rel="canonical" href="https://pestcontrolcyp.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://pestcontrolcyp.com/" />
  <meta property="og:title" content="PestControl Cyprus — Pest Experts Today" />
  <meta property="og:description" content="Professional pest control services across Cyprus. Ants, cockroaches, rodents, bed bugs, mosquitoes and more. Fast, eco-friendly, guaranteed." />
  <meta property="og:site_name" content="PestControl Cyprus" />
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <ellipse cx="12" cy="7" rx="2.5" ry="1.8" fill="white"/>
          <ellipse cx="12" cy="13" rx="3.5" ry="2.5" fill="white"/>
          <ellipse cx="12" cy="19" rx="2" ry="1.8" fill="white"/>
          <line x1="8.5" y1="11" x2="5" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="8.5" y1="13" x2="5" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="8.5" y1="15" x2="5" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="15.5" y1="11" x2="19" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="15.5" y1="13" x2="19" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="15.5" y1="15" x2="19" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="11" y1="5.5" x2="10" y2="3.5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="13" y1="5.5" x2="14" y2="3.5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="nav-logo-text">Pest<span>Control</span> Cyprus</span>
    </a>
    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#how-it-works">How It Works</a></li>
      <li><a href="#why-us">Why Us</a></li>
      <li class="nav-dropdown">
        <a href="#areas">Areas</a>
        <div class="nav-dropdown-menu">
          {cityNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="#contact" class="nav-cta">Get a Quote</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-lines"></div>
    <div class="hero-accent-circle"></div>
    <div class="hero-inner">
      <div class="hero-content">
        <span class="hero-eyebrow">Connecting You With Licensed Experts in Cyprus</span>
        <h1>Pest<br/><span>Control</span><br/>Cyprus</h1>
        <p class="hero-subtitle">Find the Right Provider for Your Home &amp; Business</p>
        <p class="hero-desc">
          We're not a pest control company — we connect you with the best licensed pest control providers across the entire island.
          Fast matching for homes and businesses in Nicosia, Limassol, Larnaca, Paphos and beyond.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn-primary">Get Matched Now</a>
          <a href="#how-it-works" class="btn-outline">How It Works</a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="hero-stat-num">15+</div>
            <div class="hero-stat-label">Years Experience</div>
          </div>
          <div>
            <div class="hero-stat-num">5,000+</div>
            <div class="hero-stat-label">Properties Treated</div>
          </div>
          <div>
            <div class="hero-stat-num">100%</div>
            <div class="hero-stat-label">Satisfaction Rate</div>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-house-circle">
          <svg width="220" height="220" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="50" y="105" width="120" height="90" rx="3" fill="#e8e6e1" opacity="0.9"/>
            <polygon points="40,108 110,45 180,108" fill="#C0392B"/>
            <rect x="90" y="145" width="30" height="50" rx="2" fill="#1a2340"/>
            <circle cx="115" cy="171" r="3" fill="#C0392B"/>
            <rect x="58" y="120" width="32" height="28" rx="2" fill="#1a2340" opacity="0.8"/>
            <line x1="74" y1="120" x2="74" y2="148" stroke="white" stroke-width="1.5"/>
            <line x1="58" y1="134" x2="90" y2="134" stroke="white" stroke-width="1.5"/>
            <rect x="130" y="120" width="32" height="28" rx="2" fill="#1a2340" opacity="0.8"/>
            <line x1="146" y1="120" x2="146" y2="148" stroke="white" stroke-width="1.5"/>
            <line x1="130" y1="134" x2="162" y2="134" stroke="white" stroke-width="1.5"/>
            <rect x="138" y="54" width="18" height="28" fill="#1a2340" opacity="0.7"/>
            <rect x="35" y="193" width="150" height="6" rx="3" fill="#4a7a4a" opacity="0.6"/>
            <rect x="55" y="197" width="110" height="4" rx="2" fill="#3a6a3a" opacity="0.4"/>
          </svg>
          <div class="hero-bug-badge top-left">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <ellipse cx="12" cy="7" rx="2.5" ry="1.8" fill="white"/>
              <ellipse cx="12" cy="13" rx="3.5" ry="2.5" fill="white"/>
              <ellipse cx="12" cy="19.5" rx="2" ry="1.8" fill="white"/>
              <line x1="8.5" y1="11" x2="5" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="8.5" y1="13" x2="5" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="8.5" y1="15" x2="5" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="15.5" y1="11" x2="19" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="15.5" y1="13" x2="19" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="15.5" y1="15" x2="19" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="hero-bug-badge top-right">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="8" r="3" fill="rgba(255,255,255,0.6)"/>
              <ellipse cx="12" cy="16" rx="5" ry="3.5" fill="rgba(255,255,255,0.6)"/>
              <line x1="7" y1="14" x2="3" y2="12" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="17" y1="14" x2="21" y2="12" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="section-header">
      <span class="section-tag">What We Cover</span>
      <h2>Pest Control Services We Match You With</h2>
      <div class="section-divider"></div>
      <p>We connect you with vetted providers who offer comprehensive treatment plans for all common pests found across Cyprus homes and businesses.</p>
    </div>
    <div class="services-grid">

      <div class="service-card">
        <div class="service-icon-circle">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <ellipse cx="12" cy="7" rx="2.5" ry="1.8" fill="white"/>
            <ellipse cx="12" cy="13" rx="3.5" ry="2.5" fill="white"/>
            <ellipse cx="12" cy="19.5" rx="2" ry="1.8" fill="white"/>
            <line x1="8.5" y1="11" x2="5" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="8.5" y1="13" x2="5" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="8.5" y1="15" x2="5" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="15.5" y1="11" x2="19" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="15.5" y1="13" x2="19" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="15.5" y1="15" x2="19" y2="17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="11" y1="5.5" x2="10" y2="3.5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="13" y1="5.5" x2="14" y2="3.5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Ants</h3>
        <p>Colony elimination using targeted baiting systems and barrier treatments. Effective against all species found in Cyprus, including fire ants.</p>
      </div>

      <div class="service-card">
        <div class="service-icon-circle dark">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <ellipse cx="12" cy="9" rx="3.5" ry="2.5" fill="white"/>
            <ellipse cx="12" cy="15.5" rx="4.5" ry="3.5" fill="white"/>
            <line x1="7" y1="13" x2="3" y2="11" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="7" y1="15.5" x2="3" y2="15.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="7" y1="18" x2="3" y2="20" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="13" x2="21" y2="11" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="15.5" x2="21" y2="15.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="18" x2="21" y2="20" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="10" y1="7" x2="8" y2="4" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="14" y1="7" x2="16" y2="4" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Cockroaches</h3>
        <p>Professional gel bait and spray treatments for kitchens, restaurants, and commercial premises. Eliminates infestations at the source.</p>
      </div>

      <div class="service-card">
        <div class="service-icon-circle">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <ellipse cx="11" cy="14" rx="6" ry="5" fill="white"/>
            <circle cx="16" cy="8" r="3.5" fill="white"/>
            <circle cx="14.5" cy="7" r="1" fill="#C0392B"/>
            <ellipse cx="18" cy="9.5" rx="1" ry="2" fill="white" transform="rotate(20 18 9.5)"/>
            <ellipse cx="14" cy="9.5" rx="1" ry="2" fill="white" transform="rotate(-20 14 9.5)"/>
            <path d="M17 18 Q20 20 22 17" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Rodents</h3>
        <p>Comprehensive rodent control including trapping, bait stations, and entry-point sealing. Rats and mice eliminated safely and humanely.</p>
      </div>

      <div class="service-card">
        <div class="service-icon-circle dark">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <ellipse cx="12" cy="13" rx="5" ry="4" fill="white"/>
            <ellipse cx="12" cy="9" rx="3" ry="2.5" fill="white"/>
            <line x1="7" y1="11" x2="4" y2="9" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="7" y1="13.5" x2="4" y2="13.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="7" y1="16" x2="4" y2="18" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="11" x2="20" y2="9" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="13.5" x2="20" y2="13.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="17" y1="16" x2="20" y2="18" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="10.5" y1="7" x2="10" y2="5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="13.5" y1="7" x2="14" y2="5" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Bed Bugs</h3>
        <p>Heat treatment and targeted pesticide application to eliminate bed bugs from mattresses, furniture, and all hiding spots completely.</p>
      </div>

      <div class="service-card">
        <div class="service-icon-circle">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="2.5" fill="white"/>
            <path d="M12 10.5 L10 16 L14 16 Z" fill="white"/>
            <line x1="10" y1="16" x2="8" y2="20" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="14" y1="16" x2="16" y2="20" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="8" y1="13" x2="4" y2="11" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="16" y1="13" x2="20" y2="11" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <path d="M9 8 Q7 5 5 6" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M15 8 Q17 5 19 6" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <line x1="12" y1="6" x2="12" y2="4" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Mosquitoes</h3>
        <p>Seasonal fogging and larvicide treatments for gardens, pools, and standing water areas. Effective protection for outdoor spaces all summer.</p>
      </div>

      <div class="service-card">
        <div class="service-icon-circle dark">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <ellipse cx="12" cy="8" rx="3" ry="2.2" fill="white"/>
            <ellipse cx="12" cy="14" rx="4" ry="3" fill="white"/>
            <path d="M9 14 Q7 12 4 13" stroke="white" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <path d="M9 16 Q7 18 4 17" stroke="white" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <path d="M15 14 Q17 12 20 13" stroke="white" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <path d="M15 16 Q17 18 20 17" stroke="white" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <line x1="12" y1="17" x2="12" y2="21" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="11" y1="6.2" x2="10.5" y2="4" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="13" y1="6.2" x2="13.5" y2="4" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M9 10 Q12 11.5 15 10" stroke="white" stroke-width="1" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <h3>Wasps &amp; Hornets</h3>
        <p>Safe removal of nests from roofs, walls, and gardens. Fully protective gear used on every job — no risk to your family or pets.</p>
      </div>

    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how-it-works" id="how-it-works">
    <div class="section-header">
      <span class="section-tag">Our Process</span>
      <h2>How It Works</h2>
      <div class="section-divider"></div>
      <p>A simple, three-step process to connect you with the right pest control provider — fast.</p>
    </div>

    <div class="steps-wrapper">
      <div class="step">
        <div class="step-circle red">
          <div class="step-number">1</div>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6" stroke="white" stroke-width="2"/>
            <line x1="15.5" y1="15.5" x2="20" y2="20" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="11" cy="11" r="2.5" fill="white" opacity="0.4"/>
          </svg>
        </div>
        <h3>Tell Us Your Problem</h3>
        <p>Fill in our short form with your location, pest type, and property details. No obligation — it takes less than a minute.</p>
      </div>

      <div class="step-connector">
        <div class="step-connector-line"></div>
      </div>

      <div class="step">
        <div class="step-circle dark">
          <div class="step-number" style="background: var(--red);">2</div>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
            <path d="M7 3 L7 12 Q7 18 12 18 Q17 18 17 12 L17 3" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <line x1="5" y1="7" x2="19" y2="7" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <path d="M12 18 L12 21" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <path d="M9 21 L15 21" stroke="white" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>Get Matched</h3>
        <p>We match your request with the best licensed pest control provider in your area — vetted, insured, and available fast.</p>
      </div>

      <div class="step-connector">
        <div class="step-connector-line"></div>
      </div>

      <div class="step">
        <div class="step-circle gray">
          <div class="step-number" style="background: var(--red);">3</div>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
            <path d="M12 3 L20 7 L20 13 Q20 18 12 21 Q4 18 4 13 L4 7 Z" stroke="#1a2340" stroke-width="2" fill="rgba(26,35,64,0.15)"/>
            <path d="M8.5 12 L11 14.5 L15.5 10" stroke="#1a2340" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3>Problem Solved</h3>
        <p>Your matched provider visits, treats the problem, and follows up. You deal directly with a trusted local expert — we make sure it's the right one.</p>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="why-us" id="why-us">
    <div class="why-us-bg"></div>
    <div class="section-header">
      <span class="section-tag">Why Choose Us</span>
      <h2>The PestControl Cyprus Difference</h2>
      <div class="section-divider"></div>
      <p>We combine deep local knowledge of Cypriot pests with a trusted network of professional providers — so you always get the right expert for the job.</p>
    </div>
    <div class="features-grid">

      <div class="feature-block">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path d="M12 2 L15 8 L22 9 L17 14 L18.5 21 L12 18 L5.5 21 L7 14 L2 9 L9 8 Z" fill="white" opacity="0.9"/>
          </svg>
        </div>
        <div class="feature-text">
          <h3>Licensed Experts</h3>
          <p>All technicians hold official Cyprus pest control certifications. Fully insured and compliant with EU standards.</p>
        </div>
      </div>

      <div class="feature-block">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="9" stroke="white" stroke-width="2"/>
            <path d="M12 7 L12 12 L16 14" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <h3>Fast Response</h3>
          <p>Same-day or next-day appointments across Cyprus. Emergency call-outs available — 24/7 phone support.</p>
        </div>
      </div>

      <div class="feature-block">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path d="M12 2 Q8 6 4 8 Q4 15 8 19 Q10 21 12 22 Q14 21 16 19 Q20 15 20 8 Q16 6 12 2Z" stroke="white" stroke-width="2" fill="rgba(255,255,255,0.1)"/>
            <path d="M9 12 L11 14 L15 10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <h3>Eco-Friendly</h3>
          <p>EU-approved, low-toxicity products. Child and pet-safe formulations available. Responsible disposal throughout.</p>
        </div>
      </div>

      <div class="feature-block">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <rect x="4" y="11" width="16" height="10" rx="2" stroke="white" stroke-width="2"/>
            <path d="M8 11 L8 7 Q8 3 12 3 Q16 3 16 7 L16 11" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="16" r="1.5" fill="white"/>
          </svg>
        </div>
        <div class="feature-text">
          <h3>Guaranteed Results</h3>
          <p>30-day pest-free guarantee on every treatment. If the problem returns, we retreat at no additional cost to you.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="areas" id="areas">
    <div class="section-header">
      <span class="section-tag">Coverage</span>
      <h2>Service Areas Across Cyprus</h2>
      <div class="section-divider"></div>
      <p>We operate island-wide, with dedicated teams in each major city for rapid response.</p>
    </div>
    <div class="areas-grid">
      <a class="area-chip" href="/pest-control-nicosia/"><span class="area-dot"></span>Nicosia</a>
      <a class="area-chip" href="/pest-control-limassol/"><span class="area-dot"></span>Limassol</a>
      <a class="area-chip" href="/pest-control-larnaca/"><span class="area-dot"></span>Larnaca</a>
      <a class="area-chip" href="/pest-control-paphos/"><span class="area-dot"></span>Paphos</a>
      <div class="area-chip"><span class="area-dot"></span>Famagusta</div>
